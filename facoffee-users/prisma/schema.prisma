generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  status        UserStatus @default(ACTIVE)
  roles         String[]
  keycloakId    String     @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime?  @updatedAt
  deactivatedAt DateTime?
}
